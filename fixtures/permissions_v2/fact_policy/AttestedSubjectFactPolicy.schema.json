    "ExactInstantFactValidity": {
      "additionalProperties": false,
      "description": "The v1 temporal meaning, written out so a v3 policy states it explicitly.\n\nv1 and v2 carry their validity in the capability itself. v3 does not: it\nselects the subject rule, and the temporal rule is chosen alongside it, so\nreading a v3 document tells you both without knowing which capability\nimplied which.",
      "properties": {
        "instants": {
          "const": "explicit_utc_exact",
          "title": "Instants",
          "type": "string"
        },
        "precision": {
          "const": "instant",
          "title": "Precision",
          "type": "string"
        },
        "semantics": {
          "const": "exact_instant_v1",
          "title": "Semantics",
          "type": "string"
        },
        "unknown": {
          "const": "withhold",
          "title": "Unknown",
          "type": "string"
        }
      },
      "required": [
        "semantics",
        "precision",
        "instants",
        "unknown"
      ],
      "title": "ExactInstantFactValidity",
      "type": "object"
    },
