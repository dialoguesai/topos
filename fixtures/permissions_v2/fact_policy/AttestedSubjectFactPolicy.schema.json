    "StatedDayFactValidity": {
      "additionalProperties": false,
      "description": "Every temporal meaning a stated-day policy relies on, selected explicitly.\n\nA `valid_from` of the exact lexical form YYYY-MM-DD is a stated calendar day\nwhose timezone basis the producers did not record. Such a day counts as\ncurrent only once it has ended at every Earth offset, i.e. from 12:00:00 UTC\non the following day. Explicit UTC instants keep their exact P2b v1 meaning.\nYear, month, naive, offset or otherwise malformed values stay unknown and\nwithhold; a stated day that has not fully elapsed withholds as not current.\nThe payload's real-world period fields are not evaluated by this contract.",
      "properties": {
        "current_from": {
          "const": "next_day_12_00_utc",
          "title": "Current From",
          "type": "string"
        },
        "instants": {
          "const": "explicit_utc_exact",
          "title": "Instants",
          "type": "string"
        },
        "not_elapsed": {
          "const": "withhold",
          "title": "Not Elapsed",
          "type": "string"
        },
        "precision": {
          "const": "day",
          "title": "Precision",
          "type": "string"
        },
        "semantics": {
          "const": "stated_day_v1",
          "title": "Semantics",
          "type": "string"
        },
        "timezone_basis": {
          "const": "unrecorded_any_earth_offset",
          "title": "Timezone Basis",
          "type": "string"
        },
        "unknown": {
          "const": "withhold",
          "title": "Unknown",
          "type": "string"
        }
      },
      "required": [
        "semantics",
        "precision",
        "timezone_basis",
        "current_from",
        "instants",
        "unknown",
        "not_elapsed"
      ],
      "title": "StatedDayFactValidity",
      "type": "object"
    },
    "Validity": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expires At",
          "type": "integer"
        },
        "starts_at": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Starts At",
          "type": "integer"
        }
      },
      "required": [
        "starts_at",
        "expires_at"
      ],
      "title": "Validity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Owner-attested subjects. Deliberately not a subclass of the v2 policy.\n\nRules, reviews and the scalar view are unchanged. Subclassing the stated-day\npolicy would make every v3 document an instance of v2 as well, and the\ndispatch that decides temporal meaning is an isinstance test. A v3 policy\nthat chose exact instants would then be evaluated as a stated-day one.",
  "properties": {
    "binding": {
      "$ref": "#/$defs/Binding"
    },
    "evaluator": {
      "$ref": "#/$defs/AttestedFactEvaluator"
    },
    "hard_constraints": {
      "$ref": "#/$defs/HardConstraints"
    },
    "natural_language": {
      "title": "Natural Language",
      "type": "null"
    },
    "policy_version_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
      "title": "Policy Version Id",
      "type": "string"
    },
    "read_budget_per_day": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Read Budget Per Day"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/FactRule"
      },
      "maxItems": 64,
      "title": "Rules",
      "type": "array"
    },
    "source_universe": {
      "$ref": "#/$defs/SourceUniverse"
    },
    "validity": {
      "$ref": "#/$defs/Validity"
