    "OwnerAttestedSubjectBinding": {
      "additionalProperties": false,
      "description": "Whom a release under this policy may be about, and what withholds.\n\nNothing here grants anything. It records which owner-identity rule the\nsigned capability selected, so the resolver cannot be asked for one rule and\nthe policy evaluated under another. Every outcome that is not a live,\ncurrent attestation is `withhold`; there is no permissive setting to pick.",
      "properties": {
        "contract": {
          "const": "owner_attested_v1",
          "title": "Contract",
          "type": "string"
        },
        "literal_self_when_shadowed": {
          "const": "withhold",
          "title": "Literal Self When Shadowed",
          "type": "string"
        },
        "moved_since_attestation": {
          "const": "withhold",
          "title": "Moved Since Attestation",
          "type": "string"
        },
        "rekeyed_facts": {
          "const": "withhold",
          "title": "Rekeyed Facts",
          "type": "string"
        },
        "statement_version": {
          "const": "owner-identity-attestation/v1",
          "title": "Statement Version",
          "type": "string"
        },
        "subjects": {
          "const": "owner_attested_entities",
          "title": "Subjects",
          "type": "string"
        },
        "unattested": {
          "const": "withhold",
          "title": "Unattested",
          "type": "string"
        }
      },
      "required": [
        "contract",
        "statement_version",
        "subjects",
        "unattested",
        "moved_since_attestation",
        "rekeyed_facts",
        "literal_self_when_shadowed"
      ],
      "title": "OwnerAttestedSubjectBinding",
      "type": "object"
    },
    "RollingEventWindow": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "const": "server_request_as_of",
          "title": "Anchor",
          "type": "string"
        },
        "event_time_semantics": {
          "const": "canonical_event_time_v1",
          "title": "Event Time Semantics",
          "type": "string"
        },
        "future": {
          "const": "withhold",
          "title": "Future",
          "type": "string"
        },
        "kind": {
          "const": "rolling",
          "title": "Kind",
          "type": "string"
        },
        "max_age_seconds": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Max Age Seconds",
          "type": "integer"
        },
        "missing_or_ambiguous": {
          "const": "withhold",
          "title": "Missing Or Ambiguous",
          "type": "string"
        }
