{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "record_id": {
          "pattern": "^r\\.[0-9a-f]{64}$",
          "title": "Record Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "source_id",
        "content"
      ],
      "title": "Citation",
      "type": "object"
    },
    "FactResult": {
      "additionalProperties": false,
      "properties": {
        "assertion": {
          "enum": [
            "owner_stated",
            "inferred"
          ],
          "title": "Assertion",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "content": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "event_at": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event At"
        },
        "kind": {
          "const": "fact",
          "title": "Kind",
          "type": "string"
        },
        "record_id": {
          "pattern": "^r\\.[0-9a-f]{64}$",
          "title": "Record Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "content",
        "source_ids",
        "citations",
        "kind",
        "assertion"
      ],
      "title": "FactResult",
      "type": "object"
    },
    "GoalResult": {
