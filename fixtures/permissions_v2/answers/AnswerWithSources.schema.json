  "additionalProperties": false,
  "properties": {
    "answer": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Answer",
      "type": "string"
    },
    "outcome": {
      "const": "answered",
      "title": "Outcome",
      "type": "string"
    },
    "records": {
      "items": {
        "discriminator": {
          "mapping": {
            "fact": "#/$defs/FactResult",
            "goal": "#/$defs/GoalResult",
            "interest": "#/$defs/InterestResult",
            "journal_entry": "#/$defs/JournalEntryResult",
            "message": "#/$defs/MessageResult",
            "relationship": "#/$defs/RelationshipResult"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/MessageResult"
          },
          {
            "$ref": "#/$defs/FactResult"
          },
          {
            "$ref": "#/$defs/GoalResult"
          },
          {
            "$ref": "#/$defs/RelationshipResult"
          },
          {
            "$ref": "#/$defs/JournalEntryResult"
          },
          {
            "$ref": "#/$defs/InterestResult"
          }
        ]
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Records",
      "type": "array"
    },
    "version": {
      "const": "topos-answer/v1",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "version",
    "outcome",
    "answer",
    "records"
  ],
  "title": "AnswerWithSources",
  "type": "object"
}
