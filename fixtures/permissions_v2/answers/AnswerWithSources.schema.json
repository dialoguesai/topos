      "required": [
        "record_id",
        "content",
        "source_ids",
        "citations",
        "kind",
        "status"
      ],
      "title": "GoalResult",
      "type": "object"
    },
    "InterestResult": {
      "additionalProperties": false,
      "description": "A monthly browsing interest: an assessed topic label, never a URL, title or host (IF-5 \u00a71.3, \u00a73).",
