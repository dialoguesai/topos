        "label": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "month": {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
          "title": "Month",
          "type": "string"
        },
        "record_id": {
          "pattern": "^r\\.[0-9a-f]{64}$",
          "title": "Record Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "strength": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Strength",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "content",
        "source_ids",
        "citations",
        "kind",
        "label",
        "month",
        "strength"
      ],
      "title": "InterestResult",
      "type": "object"
    },
