{
  "$defs": {
    "AnswerWriter": {
      "additionalProperties": false,
      "description": "Where the answer was written and by what, cut to the policy's level (`writer_level`).",
      "properties": {
        "build": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "origin": {
          "enum": [
            "local",
            "hosted"
          ],
          "title": "Origin",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "enum": [
                "ollama",
                "redpill",
                "openai",
                "anthropic",
                "grok",
                "platform"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "template": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template"
        }
      },
      "required": [
        "origin"
      ],
      "title": "AnswerWriter",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Answer",
      "type": "string"
    },
    "outcome": {
      "const": "answered",
      "title": "Outcome",
      "type": "string"
    },
    "version": {
      "const": "topos-answer/v1",
      "title": "Version",
      "type": "string"
    },
    "writer": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnswerWriter"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "version",
    "outcome",
    "answer"
  ],
  "title": "AnswerOnly",
  "type": "object"
}
