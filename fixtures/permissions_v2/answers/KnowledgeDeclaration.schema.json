{
  "$defs": {
    "OntologySelection": {
      "additionalProperties": false,
      "properties": {
        "ontology_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Ontology Id",
          "type": "string"
        },
        "predicates": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Predicates",
          "type": "array"
        },
        "revision": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "ontology_id",
        "revision",
        "predicates"
      ],
      "title": "OntologySelection",
      "type": "object"
    },
    "RollingEventWindow": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "const": "server_request_as_of",
          "title": "Anchor",
          "type": "string"
        },
        "event_time_semantics": {
          "const": "canonical_event_time_v1",
          "title": "Event Time Semantics",
          "type": "string"
        },
        "future": {
          "const": "withhold",
          "title": "Future",
          "type": "string"
        },
        "kind": {
          "const": "rolling",
          "title": "Kind",
          "type": "string"
        },
        "max_age_seconds": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Max Age Seconds",
          "type": "integer"
        },
        "missing_or_ambiguous": {
          "const": "withhold",
          "title": "Missing Or Ambiguous",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "anchor",
        "max_age_seconds",
        "event_time_semantics",
        "missing_or_ambiguous",
        "future"
      ],
      "title": "RollingEventWindow",
      "type": "object"
    },
    "SelectiveFacts": {
      "additionalProperties": false,
      "properties": {
        "catalog_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Catalog Digest",
          "type": "string"
        },
        "excluded_fact_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
            "type": "string"
          },
          "maxItems": 500,
          "title": "Excluded Fact Ids",
          "type": "array"
        },
        "ontologies": {
          "items": {
            "$ref": "#/$defs/OntologySelection"
          },
          "maxItems": 25,
          "minItems": 1,
          "title": "Ontologies",
          "type": "array"
        },
        "version": {
          "const": "selective-facts/v1",
          "title": "Version",
          "type": "string"
        },
        "vocabulary": {
          "const": "fact-ontology-vocabulary/v1",
          "title": "Vocabulary",
          "type": "string"
        }
      },
      "required": [
        "version",
        "vocabulary",
        "catalog_digest",
        "ontologies",
        "excluded_fact_ids"
      ],
      "title": "SelectiveFacts",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answers": {
      "anyOf": [
        {
          "enum": [
            "only",
            "with_sources",
            "records"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answers"
    },
    "max_k": {
      "maximum": 50,
      "minimum": 1,
      "title": "Max K",
      "type": "integer"
    },
    "max_permitted_records": {
      "maximum": 5000,
      "minimum": 1,
      "title": "Max Permitted Records",
      "type": "integer"
    },
    "release_conversation_title": {
      "anyOf": [
        {
          "const": true,
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Release Conversation Title"
    },
    "release_event_time": {
      "default": "none",
      "enum": [
        "none",
        "day",
        "second"
      ],
      "title": "Release Event Time",
      "type": "string"
    },
    "result_types": {
      "items": {
        "enum": [
          "message",
          "fact",
          "goal",
          "relationship",
          "journal_entry",
          "interest"
        ],
        "type": "string"
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Result Types",
      "type": "array"
    },
    "selective_facts": {
      "anyOf": [
        {
          "$ref": "#/$defs/SelectiveFacts"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tables": {
      "items": {
        "enum": [
          "conversation_messages",
          "ai_chat_messages",
          "journal_entries",
          "activity_events"
        ],
        "type": "string"
      },
      "title": "Tables",
      "type": "array"
    },
    "time_semantics": {
      "const": "underlying_evidence_time/v1",
      "title": "Time Semantics",
      "type": "string"
    },
    "truth_packs": {
      "anyOf": [
        {
          "items": {
            "const": "icebreakers-v1",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Truth Packs"
    },
    "view_id": {
      "const": "canonical.knowledge_search.v1",
      "title": "View Id",
      "type": "string"
    },
    "window": {
      "$ref": "#/$defs/RollingEventWindow"
    },
    "writer_disclosure": {
      "anyOf": [
        {
          "enum": [
            "origin",
            "provider",
            "model",
            "build"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Writer Disclosure"
    }
  },
  "required": [
    "view_id",
    "tables",
    "max_permitted_records",
    "max_k",
    "window",
    "result_types",
    "time_semantics"
  ],
  "title": "KnowledgeDeclaration",
  "type": "object"
}
