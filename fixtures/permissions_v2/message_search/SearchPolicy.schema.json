{
  "$defs": {
    "All": {
      "additionalProperties": false,
      "properties": {
        "growth": {
          "const": "require_consent",
          "title": "Growth",
          "type": "string"
        },
        "kind": {
          "const": "all",
          "title": "Kind",
          "type": "string"
        },
        "universe_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Universe Id",
          "type": "string"
        },
        "universe_revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Universe Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "universe_id",
        "universe_revision",
        "growth"
      ],
      "title": "All",
      "type": "object"
    },
    "AllOf": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "all_of",
          "title": "Kind",
          "type": "string"
        },
        "terms": {
          "items": {
            "discriminator": {
              "mapping": {
                "all_of": "#/$defs/AllOf",
                "any_of": "#/$defs/AnyOf",
                "atom": "#/$defs/Atom",
                "not": "#/$defs/Not"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Atom"
              },
              {
                "$ref": "#/$defs/AllOf"
              },
              {
                "$ref": "#/$defs/AnyOf"
              },
              {
                "$ref": "#/$defs/Not"
              }
            ]
          },
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "terms"
      ],
      "title": "AllOf",
      "type": "object"
    },
    "AnyOf": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "any_of",
          "title": "Kind",
          "type": "string"
        },
        "terms": {
          "items": {
            "discriminator": {
              "mapping": {
                "all_of": "#/$defs/AllOf",
                "any_of": "#/$defs/AnyOf",
                "atom": "#/$defs/Atom",
                "not": "#/$defs/Not"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Atom"
              },
              {
                "$ref": "#/$defs/AllOf"
              },
              {
                "$ref": "#/$defs/AnyOf"
              },
              {
                "$ref": "#/$defs/Not"
              }
            ]
          },
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "terms"
      ],
      "title": "AnyOf",
      "type": "object"
    },
    "Atom": {
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "enum": [
            "domain",
            "actor_role",
            "subject",
            "sensitivity"
          ],
          "title": "Attribute",
          "type": "string"
        },
        "kind": {
          "const": "atom",
          "title": "Kind",
          "type": "string"
        },
        "operator": {
          "const": "intersects",
          "title": "Operator",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
            "type": "string"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "attribute",
        "operator",
        "values"
      ],
      "title": "Atom",
      "type": "object"
    },
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Actor Id",
          "type": "string"
        },
        "assignment_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Assignment Id",
          "type": "string"
        },
        "client_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Client Id",
          "type": "string"
        },
        "environment_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Environment Id",
          "type": "string"
        },
        "grant_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Grant Id",
          "type": "string"
        },
        "node_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "owner_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Owner Id",
          "type": "string"
        },
        "resource_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "environment_id",
        "node_id",
        "resource_id",
        "owner_id",
        "actor_id",
        "client_id",
        "grant_id",
        "assignment_id"
      ],
      "title": "Binding",
      "type": "object"
    },
    "EvidenceUse": {
      "additionalProperties": false,
      "properties": {
        "new_records": {
          "const": "include_if_predicate",
          "title": "New Records",
          "type": "string"
        },
        "predicate": {
          "discriminator": {
            "mapping": {
              "all_of": "#/$defs/AllOf",
              "any_of": "#/$defs/AnyOf",
              "atom": "#/$defs/Atom",
              "not": "#/$defs/Not"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Atom"
            },
            {
              "$ref": "#/$defs/AllOf"
            },
            {
              "$ref": "#/$defs/AnyOf"
            },
            {
              "$ref": "#/$defs/Not"
            }
          ],
          "title": "Predicate"
        },
        "processors": {
          "$ref": "#/$defs/Only"
        },
        "purpose": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Purpose",
          "type": "string"
        },
        "sources": {
          "discriminator": {
            "mapping": {
              "all": "#/$defs/All",
              "only": "#/$defs/Only"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Only"
            },
            {
              "$ref": "#/$defs/All"
            }
          ],
          "title": "Sources"
        }
      },
      "required": [
        "sources",
        "predicate",
        "purpose",
        "processors",
        "new_records"
      ],
      "title": "EvidenceUse",
      "type": "object"
    },
    "HardConstraints": {
      "additionalProperties": false,
      "properties": {
        "capability_growth": {
          "const": "require_consent",
          "title": "Capability Growth",
          "type": "string"
        },
        "cross_rule_derivation": {
          "const": "deny",
          "title": "Cross Rule Derivation",
          "type": "string"
        },
        "owner_only": {
          "const": "deny",
          "title": "Owner Only",
          "type": "string"
        },
        "unknown_classification": {
          "const": "withhold",
          "title": "Unknown Classification",
          "type": "string"
        },
        "unknown_lineage": {
          "const": "withhold",
          "title": "Unknown Lineage",
          "type": "string"
        }
      },
      "required": [
        "owner_only",
        "unknown_classification",
        "unknown_lineage",
        "cross_rule_derivation",
        "capability_growth"
      ],
      "title": "HardConstraints",
      "type": "object"
    },
    "Not": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "not",
          "title": "Kind",
          "type": "string"
        },
        "term": {
          "discriminator": {
            "mapping": {
              "all_of": "#/$defs/AllOf",
              "any_of": "#/$defs/AnyOf",
              "atom": "#/$defs/Atom",
              "not": "#/$defs/Not"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Atom"
            },
            {
              "$ref": "#/$defs/AllOf"
            },
            {
              "$ref": "#/$defs/AnyOf"
            },
            {
              "$ref": "#/$defs/Not"
            }
          ],
          "title": "Term"
        }
      },
      "required": [
        "kind",
        "term"
      ],
      "title": "Not",
      "type": "object"
    },
    "Only": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "only",
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
            "type": "string"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "values"
      ],
      "title": "Only",
      "type": "object"
    },
    "OwnerAttestedSubjectBinding": {
      "additionalProperties": false,
      "description": "Whom a release under this policy may be about, and what withholds.\n\nNothing here grants anything. It records which owner-identity rule the\nsigned capability selected, so the resolver cannot be asked for one rule and\nthe policy evaluated under another. Every outcome that is not a live,\ncurrent attestation is `withhold`; there is no permissive setting to pick.",
      "properties": {
        "contract": {
          "const": "owner_attested_v1",
          "title": "Contract",
          "type": "string"
        },
        "literal_self_when_shadowed": {
          "const": "withhold",
          "title": "Literal Self When Shadowed",
          "type": "string"
        },
        "moved_since_attestation": {
          "const": "withhold",
          "title": "Moved Since Attestation",
          "type": "string"
        },
        "rekeyed_facts": {
          "const": "withhold",
          "title": "Rekeyed Facts",
          "type": "string"
        },
        "statement_version": {
          "const": "owner-identity-attestation/v1",
          "title": "Statement Version",
          "type": "string"
        },
        "subjects": {
          "const": "owner_attested_entities",
          "title": "Subjects",
          "type": "string"
        },
        "unattested": {
          "const": "withhold",
          "title": "Unattested",
          "type": "string"
        }
      },
      "required": [
        "contract",
        "statement_version",
        "subjects",
        "unattested",
        "moved_since_attestation",
        "rekeyed_facts",
        "literal_self_when_shadowed"
      ],
      "title": "OwnerAttestedSubjectBinding",
      "type": "object"
    },
    "RollingEventWindow": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "const": "server_request_as_of",
          "title": "Anchor",
          "type": "string"
        },
        "event_time_semantics": {
          "const": "canonical_event_time_v1",
          "title": "Event Time Semantics",
          "type": "string"
        },
        "future": {
          "const": "withhold",
          "title": "Future",
          "type": "string"
        },
        "kind": {
          "const": "rolling",
          "title": "Kind",
          "type": "string"
        },
        "max_age_seconds": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Max Age Seconds",
          "type": "integer"
        },
        "missing_or_ambiguous": {
          "const": "withhold",
          "title": "Missing Or Ambiguous",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "anchor",
        "max_age_seconds",
        "event_time_semantics",
        "missing_or_ambiguous",
        "future"
      ],
      "title": "RollingEventWindow",
      "type": "object"
    },
    "SearchDeclaration": {
      "additionalProperties": false,
      "description": "What the owner consented to on top of the rules: search, its view, its bounds.",
      "properties": {
        "max_k": {
          "maximum": 25,
          "minimum": 1,
          "title": "Max K",
          "type": "integer"
        },
        "max_permitted_records": {
          "maximum": 5000,
          "minimum": 1,
          "title": "Max Permitted Records",
          "type": "integer"
        },
        "release_event_time": {
          "default": "none",
          "enum": [
            "none",
            "day",
            "second"
          ],
          "title": "Release Event Time",
          "type": "string"
        },
        "tables": {
          "items": {
            "enum": [
              "conversation_messages",
              "ai_chat_messages"
            ],
            "type": "string"
          },
          "title": "Tables",
          "type": "array"
        },
        "view_id": {
          "const": "canonical.message_search.v1",
          "title": "View Id",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/RollingEventWindow"
        }
      },
      "required": [
        "view_id",
        "tables",
        "max_permitted_records",
        "max_k",
        "window"
      ],
      "title": "SearchDeclaration",
      "type": "object"
    },
    "SearchEvaluator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "hard_rules",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "const": "hard-rules/p2c-v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "version"
      ],
      "title": "SearchEvaluator",
      "type": "object"
    },
    "SearchOutputForm": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "canonical_record",
          "title": "Family",
          "type": "string"
        },
        "operation": {
          "const": "search",
          "title": "Operation",
          "type": "string"
        },
        "tables": {
          "items": {
            "enum": [
              "conversation_messages",
              "ai_chat_messages"
            ],
            "type": "string"
          },
          "title": "Tables",
          "type": "array"
        },
        "view_id": {
          "const": "canonical.message_search.v1",
          "title": "View Id",
          "type": "string"
        }
      },
      "required": [
        "family",
        "operation",
        "view_id",
        "tables"
      ],
      "title": "SearchOutputForm",
      "type": "object"
    },
    "SearchRelease": {
      "additionalProperties": false,
      "properties": {
        "ceiling": {
          "const": "raw",
          "title": "Ceiling",
          "type": "string"
        },
        "forms": {
          "items": {
            "$ref": "#/$defs/SearchOutputForm"
          },
          "title": "Forms",
          "type": "array"
        },
        "predicate": {
          "discriminator": {
            "mapping": {
              "all_of": "#/$defs/AllOf",
              "any_of": "#/$defs/AnyOf",
              "atom": "#/$defs/Atom",
              "not": "#/$defs/Not"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Atom"
            },
            {
              "$ref": "#/$defs/AllOf"
            },
            {
              "$ref": "#/$defs/AnyOf"
            },
            {
              "$ref": "#/$defs/Not"
            }
          ],
          "title": "Predicate"
        }
      },
      "required": [
        "predicate",
        "ceiling",
        "forms"
      ],
      "title": "SearchRelease",
      "type": "object"
    },
    "SearchRule": {
      "additionalProperties": false,
      "properties": {
        "effect": {
          "enum": [
            "permit",
            "deny"
          ],
          "title": "Effect",
          "type": "string"
        },
        "evidence_use": {
          "$ref": "#/$defs/EvidenceUse"
        },
        "release": {
          "$ref": "#/$defs/SearchRelease"
        },
        "rule_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "effect",
        "evidence_use",
        "release"
      ],
      "title": "SearchRule",
      "type": "object"
    },
    "SearchVersions": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "const": "permissions-beta/p2c-v1",
          "title": "Capability",
          "type": "string"
        },
        "subject_binding": {
          "$ref": "#/$defs/OwnerAttestedSubjectBinding"
        },
        "vocabulary": {
          "const": "owner-review-vocabulary/v1",
          "title": "Vocabulary",
          "type": "string"
        }
      },
      "required": [
        "vocabulary",
        "capability",
        "subject_binding"
      ],
      "title": "SearchVersions",
      "type": "object"
    },
    "SourceUniverse": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "source_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "universe_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Universe Id",
          "type": "string"
        }
      },
      "required": [
        "universe_id",
        "revision",
        "source_ids"
      ],
      "title": "SourceUniverse",
      "type": "object"
    },
    "Validity": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expires At",
          "type": "integer"
        },
        "starts_at": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Starts At",
          "type": "integer"
        }
      },
      "required": [
        "starts_at",
        "expires_at"
      ],
      "title": "Validity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "binding": {
      "$ref": "#/$defs/Binding"
    },
    "evaluator": {
      "$ref": "#/$defs/SearchEvaluator"
    },
    "hard_constraints": {
      "$ref": "#/$defs/HardConstraints"
    },
    "natural_language": {
      "title": "Natural Language",
      "type": "null"
    },
    "policy_version_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
      "title": "Policy Version Id",
      "type": "string"
    },
    "read_budget_per_day": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Read Budget Per Day"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/SearchRule"
      },
      "title": "Rules",
      "type": "array"
    },
    "search": {
      "$ref": "#/$defs/SearchDeclaration"
    },
    "source_universe": {
      "$ref": "#/$defs/SourceUniverse"
    },
    "validity": {
      "$ref": "#/$defs/Validity"
    },
    "version": {
      "const": "topos-policy/v2",
      "title": "Version",
      "type": "string"
    },
    "versions": {
      "$ref": "#/$defs/SearchVersions"
    }
  },
  "required": [
    "version",
    "policy_version_id",
    "binding",
    "versions",
    "validity",
    "source_universe",
    "hard_constraints",
    "rules",
    "search",
    "evaluator",
    "natural_language"
  ],
  "title": "SearchPolicy",
  "type": "object"
}
