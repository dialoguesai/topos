{
  "$defs": {
    "SearchRecord": {
      "additionalProperties": false,
      "properties": {
        "canonical_table": {
          "enum": [
            "conversation_messages",
            "ai_chat_messages"
          ],
          "title": "Canonical Table",
          "type": "string"
        },
        "content": {
          "maxLength": 100000,
          "title": "Content",
          "type": "string"
        },
        "event_at": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Event At",
          "type": "integer"
        },
        "record_id": {
          "pattern": "^r\\.[0-9a-f]{64}$",
          "title": "Record Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "source_id",
        "canonical_table",
        "event_at",
        "content"
      ],
      "title": "SearchRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "family": {
      "const": "canonical_record",
      "title": "Family",
      "type": "string"
    },
    "operation": {
      "const": "search",
      "title": "Operation",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/SearchRecord"
      },
      "maxItems": 25,
      "title": "Records",
      "type": "array"
    },
    "view_id": {
      "const": "canonical.message_search.v1",
      "title": "View Id",
      "type": "string"
    }
  },
  "required": [
    "family",
    "operation",
    "view_id",
    "records"
  ],
  "title": "MessageSearchResult",
  "type": "object"
}
