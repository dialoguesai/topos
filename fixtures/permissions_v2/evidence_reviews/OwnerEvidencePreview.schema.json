{
  "$defs": {
    "EvidenceBinding": {
      "additionalProperties": false,
      "description": "Pinned by the node runtime to this resource; never a recipient parameter.",
      "properties": {
        "environment_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Environment Id",
          "type": "string"
        },
        "node_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "owner_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Owner Id",
          "type": "string"
        },
        "resource_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "environment_id",
        "node_id",
        "resource_id",
        "owner_id"
      ],
      "title": "EvidenceBinding",
      "type": "object"
    },
    "EvidenceIdentity": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/EvidenceBinding"
        },
        "dataset_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dataset Id"
        },
        "dataset_kind": {
          "enum": [
            "row_dataset",
            "node_resource"
          ],
          "title": "Dataset Kind",
          "type": "string"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Id"
        },
        "table": {
          "enum": [
            "signal_objects",
            "conversation_messages",
            "ai_chat_messages"
          ],
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "binding",
        "table",
        "record_id",
        "source_id",
        "dataset_kind",
        "dataset_id"
      ],
      "title": "EvidenceIdentity",
      "type": "object"
    },
    "EvidenceRevision": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/EvidenceIdentity"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "identity",
        "revision"
      ],
      "title": "EvidenceRevision",
      "type": "object"
    },
    "EvidenceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/EvidenceRevision"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "binding": {
          "$ref": "#/$defs/EvidenceBinding"
        },
        "candidate_revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Revision",
          "type": "string"
        },
        "canonical_file_revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical File Revision",
          "type": "string"
        },
        "fact_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Fact Id",
          "type": "string"
        },
        "leaves": {
          "items": {
            "$ref": "#/$defs/EvidenceRevision"
          },
          "title": "Leaves",
          "type": "array"
        },
        "lineage_revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lineage Revision",
          "type": "string"
        },
        "protection_revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Protection Revision",
          "type": "string"
        }
      },
      "required": [
        "binding",
        "canonical_file_revision",
        "fact_id",
        "candidate_revision",
        "lineage_revision",
        "protection_revision",
        "artifacts",
        "leaves"
      ],
      "title": "EvidenceSnapshot",
      "type": "object"
    },
    "NullCell": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "null",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "NullCell",
      "type": "object"
    },
    "OwnerEvidenceReview": {
      "additionalProperties": false,
      "properties": {
        "classifications": {
          "items": {
            "$ref": "#/$defs/ReviewedClassification"
          },
          "title": "Classifications",
          "type": "array"
        },
        "owner_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Owner Id",
          "type": "string"
        },
        "review_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Review Id",
          "type": "string"
        },
        "reviewed_at": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Reviewed At",
          "type": "integer"
        },
        "snapshot": {
          "$ref": "#/$defs/EvidenceSnapshot"
        },
        "version": {
          "const": "topos-owner-evidence-review/v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "review_id",
        "owner_id",
        "reviewed_at",
        "snapshot",
        "classifications"
      ],
      "title": "OwnerEvidenceReview",
      "type": "object"
    },
    "OwnerPreviewRecord": {
      "additionalProperties": false,
      "properties": {
        "cells": {
          "additionalProperties": {
            "discriminator": {
              "mapping": {
                "blob": "#/$defs/ValueCell",
                "float": "#/$defs/ValueCell",
                "integer": "#/$defs/ValueCell",
                "null": "#/$defs/NullCell",
                "text": "#/$defs/ValueCell"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/NullCell"
              },
              {
                "$ref": "#/$defs/ValueCell"
              }
            ]
          },
          "title": "Cells",
          "type": "object"
        },
        "disclosure": {
          "anyOf": [
            {
              "enum": [
                "scoped",
                "owner_only",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disclosure"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceRevision"
        },
        "protected_record": {
          "title": "Protected Record",
          "type": "boolean"
        }
      },
      "required": [
        "evidence",
        "cells",
        "disclosure",
        "protected_record"
      ],
      "title": "OwnerPreviewRecord",
      "type": "object"
    },
    "QualificationSummary": {
      "additionalProperties": false,
      "properties": {
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "qualified",
            "withheld"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "reason_code"
      ],
      "title": "QualificationSummary",
      "type": "object"
    },
    "ReviewedClassification": {
      "additionalProperties": false,
      "description": "Explicit human attestation of one exact fact or leaf, not model output.",
      "properties": {
        "authorship": {
          "enum": [
            "owner_authored",
            "other",
            "unknown"
          ],
          "title": "Authorship",
          "type": "string"
        },
        "domains": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
            "type": "string"
          },
          "title": "Domains",
          "type": "array"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceRevision"
        },
        "independent_copies": {
          "enum": [
            "none_known",
            "present",
            "unknown"
          ],
          "title": "Independent Copies",
          "type": "string"
        },
        "sensitivity": {
          "enum": [
            "none",
            "personal",
            "special",
            "unknown"
          ],
          "title": "Sensitivity",
          "type": "string"
        },
        "speech": {
          "enum": [
            "direct_self_statement",
            "third_party_quote",
            "mixed",
            "unknown"
          ],
          "title": "Speech",
          "type": "string"
        },
        "subject_entity_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
            "type": "string"
          },
          "title": "Subject Entity Ids",
          "type": "array"
        }
      },
      "required": [
        "evidence",
        "domains",
        "sensitivity",
        "subject_entity_ids",
        "authorship",
        "speech",
        "independent_copies"
      ],
      "title": "ReviewedClassification",
      "type": "object"
    },
    "ValueCell": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "integer",
            "float",
            "text",
            "blob"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "ValueCell",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "current_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/OwnerEvidenceReview"
        },
        {
          "type": "null"
        }
      ]
    },
    "current_review_revision": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Current Review Revision"
    },
    "entity_protection_present": {
      "title": "Entity Protection Present",
      "type": "boolean"
    },
    "execution_enabled": {
      "const": false,
      "title": "Execution Enabled",
      "type": "boolean"
    },
    "fact_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
      "title": "Fact Id",
      "type": "string"
    },
    "qualification": {
      "$ref": "#/$defs/QualificationSummary"
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason Code"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/OwnerPreviewRecord"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Records",
      "type": "array"
    },
    "snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "complete",
        "incomplete"
      ],
      "title": "Status",
      "type": "string"
    },
    "version": {
      "const": "topos-owner-evidence-preview/v1",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "version",
    "fact_id",
    "current_review",
    "current_review_revision",
    "qualification",
    "execution_enabled",
    "status",
    "reason_code",
    "snapshot",
    "records",
    "entity_protection_present"
  ],
  "title": "OwnerEvidencePreview",
  "type": "object"
}
