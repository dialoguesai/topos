{
  "additionalProperties": false,
  "description": "A page of the owner's review queue: least confident first, so the owner reviews what the model doubted.",
  "properties": {
    "include_opted_out": {
      "default": true,
      "title": "Include Opted Out",
      "type": "boolean"
    },
    "limit": {
      "default": 50,
      "maximum": 200,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Offset",
      "type": "integer"
    },
    "source_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Id"
    }
  },
  "title": "ReviewQueueRequest",
  "type": "object"
}
