{
  "$defs": {
    "AppliedCommandReceipt": {
      "additionalProperties": false,
      "properties": {
        "applied_at": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Applied At",
          "type": "integer"
        },
        "authority": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthorityBinding"
            },
            {
              "$ref": "#/$defs/FactAuthorityBinding"
            }
          ],
          "title": "Authority"
        },
        "command_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Command Hash",
          "type": "string"
        },
        "command_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Command Id",
          "type": "string"
        },
        "operation": {
          "enum": [
            "activate",
            "revoke"
          ],
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "command_hash",
        "operation",
        "authority",
        "applied_at"
      ],
      "title": "AppliedCommandReceipt",
      "type": "object"
    },
    "AuthorityBinding": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Actor Id",
          "type": "string"
        },
        "assignment_generation": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Assignment Generation",
          "type": "integer"
        },
        "assignment_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Assignment Id",
          "type": "string"
        },
        "capability_version": {
          "const": "permissions-beta/p2a-v1",
          "title": "Capability Version",
          "type": "string"
        },
        "client_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Client Id",
          "type": "string"
        },
        "environment_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Environment Id",
          "type": "string"
        },
        "grant_generation": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Grant Generation",
          "type": "integer"
        },
        "grant_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Grant Id",
          "type": "string"
        },
        "node_epoch": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Node Epoch",
          "type": "integer"
        },
        "node_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "owner_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Owner Id",
          "type": "string"
        },
        "policy_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Hash",
          "type": "string"
        },
        "policy_version_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Policy Version Id",
          "type": "string"
        },
        "protection_revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Protection Revision",
          "type": "string"
        },
        "resource_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "environment_id",
        "node_id",
        "resource_id",
        "owner_id",
        "actor_id",
        "client_id",
        "grant_id",
        "assignment_id",
        "grant_generation",
        "assignment_generation",
        "policy_version_id",
        "policy_hash",
        "capability_version",
        "protection_revision",
        "node_epoch"
      ],
      "title": "AuthorityBinding",
      "type": "object"
    },
    "FactAuthorityBinding": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Actor Id",
          "type": "string"
        },
        "assignment_generation": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Assignment Generation",
          "type": "integer"
        },
        "assignment_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Assignment Id",
          "type": "string"
        },
        "capability_version": {
          "enum": [
            "permissions-beta/p2b-v1",
            "permissions-beta/p2b-v2",
            "permissions-beta/p2b-v3",
            "permissions-beta/p2b-v4"
          ],
          "title": "Capability Version",
          "type": "string"
        },
        "client_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Client Id",
          "type": "string"
        },
        "environment_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Environment Id",
          "type": "string"
        },
        "grant_generation": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Grant Generation",
          "type": "integer"
        },
        "grant_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Grant Id",
          "type": "string"
        },
        "node_epoch": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Node Epoch",
          "type": "integer"
        },
        "node_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "owner_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Owner Id",
          "type": "string"
        },
        "policy_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Hash",
          "type": "string"
        },
        "policy_version_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Policy Version Id",
          "type": "string"
        },
        "protection_revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Protection Revision",
          "type": "string"
        },
        "resource_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "environment_id",
        "node_id",
        "resource_id",
        "owner_id",
        "actor_id",
        "client_id",
        "grant_id",
        "assignment_id",
        "grant_generation",
        "assignment_generation",
        "policy_version_id",
        "policy_hash",
        "capability_version",
        "protection_revision",
        "node_epoch"
      ],
      "title": "FactAuthorityBinding",
      "type": "object"
    },
    "NodeGrantState": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthorityBinding"
            },
            {
              "$ref": "#/$defs/FactAuthorityBinding"
            },
            {
              "type": "null"
            }
          ],
          "title": "Authority"
        },
        "grant_state": {
          "enum": [
            "active",
            "revoked",
            "absent"
          ],
          "title": "Grant State",
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/NodeIdentity"
        },
        "node_epoch": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Node Epoch",
          "type": "integer"
        },
        "protection_revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Protection Revision",
          "type": "string"
        }
      },
      "required": [
        "identity",
        "node_epoch",
        "protection_revision",
        "grant_state",
        "authority"
      ],
      "title": "NodeGrantState",
      "type": "object"
    },
    "NodeIdentity": {
      "additionalProperties": false,
      "properties": {
        "environment_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Environment Id",
          "type": "string"
        },
        "node_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "owner_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Owner Id",
          "type": "string"
        },
        "resource_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "environment_id",
        "node_id",
        "resource_id",
        "owner_id"
      ],
      "title": "NodeIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "audience_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
      "title": "Audience Id",
      "type": "string"
    },
    "command_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Command Hash"
    },
    "command_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Command Id"
    },
    "expires_at": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Expires At",
      "type": "integer"
    },
    "issued_at": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Issued At",
      "type": "integer"
    },
    "issuer_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
      "title": "Issuer Id",
      "type": "string"
    },
    "kid": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
      "title": "Kid",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "applied",
        "already_applied",
        "rejected",
        "status"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "reason_code": {
      "enum": [
        "ok",
        "epoch_conflict",
        "generation_stale",
        "binding_conflict",
        "immutable_policy",
        "policy_time",
        "protection_changed",
        "command_conflict",
        "command_unknown",
        "command_invalid"
      ],
      "title": "Reason Code",
      "type": "string"
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/AppliedCommandReceipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "request_kind": {
      "enum": [
        "mutation",
        "status"
      ],
      "title": "Request Kind",
      "type": "string"
    },
    "response_to": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Response To",
      "type": "string"
    },
    "signature": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "title": "Signature",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/NodeGrantState"
    },
    "version": {
      "const": "topos-policy-ack/v2",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "version",
    "kid",
    "issuer_id",
    "audience_id",
    "response_to",
    "request_kind",
    "request_id",
    "command_id",
    "command_hash",
    "outcome",
    "reason_code",
    "receipt",
    "state",
    "issued_at",
    "expires_at",
    "signature"
  ],
  "title": "SignedAck",
  "type": "object"
}
