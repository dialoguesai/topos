# Copy to topos/.env or export in your shell (see README). Never commit real secrets.
#
# Minimal onboarding: only TOPOS_KEY is required for local + hosted defaults.
# Runtime defaults (control plane URL, sync URL, DB mode, etc.) are defined in
# topos/config/settings.py.

TOPOS_KEY=

# --- Optional local overrides (defaults are in topos/config/settings.py) ---
# ENGINE_MAX_RESIDENT_MODELS=3
# PRIVACY_FILTER_DEVICE=cpu

# Optional overrides (only set if you need non-default behavior):
# TOPOS_CONTROL_PLANE_URL=wss://cp.logu3s.com/ws/engine
# CONTROL_PLANE_VERIFY_SSL=true
# OPENAI_API_KEY=
# RED_PILL_API_KEY=   # Topos Secure (signal extraction + generative enrichment via api.redpill.ai)
# TOPOS_USER_ID=
#
# Additional engine memory tuning (see topos/docs/ml-manager-v2/MEMORY_MANAGEMENT.md):
# ENGINE_FLUSH_AFTER_TASK=false
# ENGINE_MODEL_IDLE_TTL_SEC=0
# ENGINE_MEMORY_RSS_SOFT_LIMIT_MB=0
# ENGINE_ML_DEVICE=cpu
# TOPOS_ENGINE_SERVICE_URL=
# PRIVACY_FILTER_ENABLED=true
# NSFW_CLASSIFIER_ENABLED=true
