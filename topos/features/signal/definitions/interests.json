{
  "definition_version": "1.0.0",
  "dimension_id": "interests",
  "status": "typed",
  "core_question": "What are they paying attention to, what did that crowd out, and how concentrated is their focus against their own baseline?",
  "primary_entity_types": [
    {
      "id": "InterestTopic",
      "description": "A recurring subject of attention with weight against the owner's own baseline.",
      "fields": [
        "label",
        "weight",
        "trend_band",
        "first_seen_at",
        "evidence_count"
      ]
    },
    {
      "id": "AttentionVerdict",
      "description": "Triage outcome for a day's items \u2014 signal, surface, or distraction \u2014 as coarse groups only.",
      "fields": [
        "verdict_kind",
        "group_label",
        "count",
        "day"
      ]
    },
    {
      "id": "FocusReading",
      "description": "Concentration of attention for a window, relative to the owner's personal baseline.",
      "fields": [
        "focus_index",
        "structure_clarity",
        "information_breadth",
        "pipeline_confidence",
        "trend",
        "baseline_delta"
      ]
    },
    {
      "id": "ShiftSpike",
      "description": "A week-over-week change in the shape of attention.",
      "fields": [
        "score",
        "interpretation",
        "current_week",
        "magnitude_band"
      ]
    },
    {
      "id": "InfluenceThread",
      "description": "A ranked thread shaping current focus.",
      "fields": [
        "thread_label",
        "influence_rank",
        "entity_lens"
      ]
    }
  ],
  "signal_objects": [
    "interest_profile",
    "attention_summary",
