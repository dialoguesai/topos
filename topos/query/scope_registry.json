{
  "$schema": "topos/scope-registry-v2",
  "version": "2.0.0",
  "description": "Engine scope catalog synced from control_plane/uma/scope_registry.json. Run: just sync-scope-registry",
  "scopes": [
    {
      "scope_id": "activity:read",
      "description": "Web-browsing and app activity: pages visited, activity events, and the interest topics derived from them.",
      "example_questions": [
        "What did I browse about kayaks this week?",
        "What websites do I spend the most time on?"
      ],
      "primary_dimensions": [
        "Profile",
        "Interests"
      ],
      "raw_tables": [
        "activity_events"
      ],
      "signal_objects": [
        "activity_tags",
        "top_topics"
      ],
      "summary_objects": [
        "activity_summary"
      ],
      "inference_objects": [
        "interest_scores"
      ],
      "default_mode_ceiling": "summary",
      "implementation_status": "live",
      "default_source_ids": [
        "demo_browser_file",
        "browser_visits",
        "browser_events"
      ]
    },
    {
      "scope_id": "ai_conversations:read",
      "description": "AI chat history (ChatGPT and Topos chats): conversations, discussion topics, and goals extracted from them.",
      "example_questions": [
        "What have I been asking ChatGPT about lately?",
        "What goals have I mentioned in my AI chats?"
      ],
      "primary_dimensions": [
        "Memory",
        "Work"
      ],
      "raw_tables": [
        "ai_chat_messages"
      ],
      "signal_objects": [
        "message_topics",
        "user_goals"
      ],
      "summary_objects": [
        "memory_dimension_summary"
      ],
      "inference_objects": [
        "goal_inference"
      ],
      "default_mode_ceiling": "inference",
      "default_source_ids": [
        "chatgpt_file_ingestion",
        "chatgpt_ingestion",
        "chatgpt_ui_conversation"
      ],
      "implementation_status": "live"
    },
    {
      "scope_id": "availability:read",
      "description": "Free/busy availability windows derived from the schedule \u2014 never event titles or message content.",
      "example_questions": [
        "When am I free on Thursday afternoon?"
      ],
      "primary_dimensions": [
        "Time"
      ],
      "raw_tables": [],
      "signal_objects": [
        "availability_scores",
        "busy_blocks"
      ],
      "summary_objects": [
        "availability_summary"
      ],
      "inference_objects": [
        "availability_windows"
      ],
      "default_mode_ceiling": "inference",
      "must_not_retrieve": [
        "calendar_events.title",
        "conversation_messages.content",
        "content"
      ],
      "implementation_status": "live",
      "fit_facets_exposed": [
        "timing_feasibility",
        "commitment_conflict"
      ],
      "required_health": {
        "time.depth_score": 0.3
      },
      "default_source_ids": [
        "demo_calendar_file",
        "calendar_stub"
      ]
    },
    {
      "scope_id": "contacts:resolve",
      "description": "Contact and identifier resolution used to link names, numbers, and handles to people. Enrichment-only scope.",
      "example_questions": [
        "Which contact does this phone number belong to?"
      ],
      "primary_dimensions": [
        "Relationships"
      ],
      "raw_tables": [
        "contacts",
        "contact_identifiers"
      ],
      "signal_objects": [],
      "summary_objects": [],
      "inference_objects": [],
      "default_mode_ceiling": "raw",
      "enrichment_only": true,
      "implementation_status": "live",
      "default_source_ids": [
        "canonical_address_book"
      ]
    },
    {
      "scope_id": "health:read",
      "description": "Wellbeing signals from journal entries: moods, wellness summaries, and wellness scores.",
      "example_questions": [
        "How has my mood trended this month?"
      ],
      "primary_dimensions": [
        "Wellbeing"
      ],
      "raw_tables": [
        "journal_entries"
      ],
      "signal_objects": [],
      "summary_objects": [
        "wellness_summary"
      ],
      "inference_objects": [
        "wellness_scores"
      ],
      "default_mode_ceiling": "summary",
      "implementation_status": "live",
      "default_source_ids": [
        "demo_journal_file"
      ]
    },
    {
      "scope_id": "messages:read",
      "description": "Person-to-person messages (iMessage, Signal, messenger imports): message text, excerpts, entities, and emotion signals.",
      "example_questions": [
        "Find the messages where we planned the trip.",
        "Who do I message most?"
      ],
      "primary_dimensions": [
        "Relationships",
        "Memory"
      ],
      "raw_tables": [
        "conversation_messages"
      ],
      "signal_objects": [
        "message_entities",
        "message_emotions"
      ],
      "summary_objects": [
        "message_excerpts_summary"
      ],
      "inference_objects": [
        "message_inference"
      ],
      "default_mode_ceiling": "summary",
      "implementation_status": "live",
      "default_source_ids": [
        "demo_messenger_file",
        "imessage",
        "signal"
      ]
    },
    {
      "scope_id": "places:read",
      "description": "Location events and place visits.",
      "example_questions": [
        "What cities have I visited most?"
      ],
      "primary_dimensions": [
        "Places"
      ],
      "raw_tables": [
        "location_events"
      ],
      "signal_objects": [],
      "summary_objects": [
        "location_context"
      ],
      "inference_objects": [],
      "default_mode_ceiling": "summary",
      "default_source_ids": [
        "demo_places_file"
      ],
      "implementation_status": "live"
    },
    {
      "scope_id": "public_bio:read",
      "description": "The public profile summary \u2014 the bio shared with anyone.",
      "example_questions": [
        "What does my public bio say?"
      ],
      "primary_dimensions": [
        "Profile"
      ],
      "raw_tables": [],
      "signal_objects": [],
      "summary_objects": [
        "public_bio"
      ],
      "inference_objects": [],
      "default_mode_ceiling": "summary",
      "implementation_status": "live",
      "default_source_ids": [
        "demo_resume_file"
      ]
    },
    {
      "scope_id": "relationship_context:read",
      "description": "Relationship signals derived from communications: who you interact with and how those connections evolve. No raw message text.",
      "example_questions": [
        "Who have I been closest to lately?"
      ],
      "primary_dimensions": [
        "Relationships"
      ],
      "raw_tables": [],
      "signal_objects": [
        "relationship_edges",
        "relationship_scores"
      ],
      "summary_objects": [
        "relationship_dimension_summary"
      ],
      "inference_objects": [
        "relationship_inference"
      ],
      "default_mode_ceiling": "inference",
      "implementation_status": "live",
      "fit_facets_exposed": [
        "relationship_warmth",
        "domain_overlap"
      ],
      "default_source_ids": [
        "demo_contacts_file",
        "demo_messenger_file"
      ]
    },
    {
      "scope_id": "resources:read",
      "description": "Financial transactions and spending summaries.",
      "example_questions": [
        "What did I spend on dining last month?"
      ],
      "primary_dimensions": [
        "Resources"
      ],
      "raw_tables": [
        "financial_transactions"
      ],
      "signal_objects": [],
      "summary_objects": [
        "financial_summary"
      ],
      "inference_objects": [],
      "default_mode_ceiling": "summary",
      "default_source_ids": [
        "demo_financial_file"
      ],
      "implementation_status": "live"
    },
    {
      "scope_id": "schedule:read",
      "description": "Calendar events and schedule summaries.",
      "example_questions": [
        "What is on my calendar this week?"
      ],
      "primary_dimensions": [
        "Time"
      ],
      "raw_tables": [
        "calendar_events"
      ],
      "signal_objects": [
        "event_counts"
      ],
      "summary_objects": [
        "schedule_summary"
      ],
      "inference_objects": [],
      "default_mode_ceiling": "summary",
      "implementation_status": "live",
      "default_source_ids": [
        "demo_calendar_file",
        "calendar_stub"
      ]
    },
    {
      "scope_id": "work_context:read",
      "description": "Work goals and context extracted from AI conversations.",
      "example_questions": [
        "What am I working on right now?"
      ],
      "primary_dimensions": [
        "Work"
      ],
      "raw_tables": [],
      "signal_objects": [
        "user_goals"
      ],
      "summary_objects": [
        "work_stub_summary"
      ],
      "inference_objects": [],
      "default_mode_ceiling": "summary",
      "default_source_ids": [
        "chatgpt_ingestion",
        "chatgpt_file_ingestion",
        "chatgpt_ui_conversation",
        "demo_resume_file"
      ],
      "implementation_status": "live"
    }
  ],
  "migration_from_legacy": {
    "aiMessages:read": "ai_conversations:read",
    "aiChat:read": "ai_conversations:read",
    "events:read": "schedule:read",
    "events:write": "schedule:read",
    "activitySummary:read": "activity:read",
    "wellnessSummary:read": "health:read",
    "publicBio:read": "public_bio:read",
    "messages:read": "messages:read",
    "activity:read": "activity:read",
    "journal:read": "health:read",
    "contacts:resolve": "contacts:resolve"
  }
}
