{
  "$schema": "topos/scope-registry-v2",
  "version": "2.0.0",
  "description": "Engine scope catalog synced from control_plane/uma/scope_registry.json. Run: just sync-scope-registry",
  "scopes": [
    {
      "scope_id": "activity:read",
      "description": "Web-browsing and app activity: pages visited, activity events, and the interest topics derived from them.",
      "example_questions": [
        "What did I browse about kayaks this week?",
        "What websites do I spend the most time on?"
      ],
      "primary_dimensions": [
        "Profile",
        "Interests"
      ],
      "raw_tables": [
        "activity_events"
      ],
      "signal_objects": [
        "activity_tags",
        "top_topics"
      ],
      "summary_objects": [
        "activity_summary"
      ],
      "inference_objects": [
        "interest_scores"
      ],
      "default_mode_ceiling": "summary",
      "implementation_status": "live",
      "default_source_ids": [
        "demo_browser_file",
        "browser_visits",
        "browser_events"
      ]
    },
    {
      "scope_id": "ai_conversations:read",
      "description": "AI chat history (ChatGPT and Topos chats): conversations, discussion topics, and goals extracted from them.",
      "example_questions": [
        "What have I been asking ChatGPT about lately?",
        "What goals have I mentioned in my AI chats?"
      ],
      "primary_dimensions": [
        "Memory",
        "Work"
      ],
      "raw_tables": [
        "ai_chat_messages"
      ],
      "signal_objects": [
        "message_topics",
        "user_goals"
      ],
      "summary_objects": [
        "memory_dimension_summary"
      ],
      "inference_objects": [
        "goal_inference"
      ],
      "default_mode_ceiling": "inference",
      "default_source_ids": [
        "chatgpt_file_ingestion",
        "chatgpt_ingestion",
        "chatgpt_ui_conversation"
      ],
      "implementation_status": "live"
    },
    {
      "scope_id": "attention:read",
      "description": "Attention triage: daily interest profiles, triage digests (what deserved attention, what was missed, distraction patterns), and the verdict ledger behind them.",
      "example_questions": [
        "What did I miss yesterday that matters?",
        "What were my distraction patterns this week?",
        "What did you filter out this week?"
      ],
      "primary_dimensions": [
        "Interests"
      ],
      "raw_tables": [],
      "signal_objects": [
        "interest_profile",
        "attention_summary"
      ],
      "summary_objects": [
        "attention_summary"
      ],
      "inference_objects": [
        "interest_profile"
      ],
      "default_mode_ceiling": "summary",
      "default_source_ids": [],
      "implementation_status": "live"
    },
    {
      "scope_id": "availability:read",
      "description": "Free/busy availability windows derived from the schedule \u2014 never event titles or message content.",
      "example_questions": [
        "When am I free on Thursday afternoon?"
      ],
      "primary_dimensions": [
        "Time"
      ],
      "raw_tables": [],
      "signal_objects": [
        "availability_scores",
        "availability_window_scores",
        "commitment_hard_blocks",
        "flex_windows",
        "meeting_load_band",
        "routine_confidence"
      ],
      "summary_objects": [
        "availability_summary"
      ],
      "inference_objects": [
        "availability_window_scores",
        "flex_windows"
      ],
      "default_mode_ceiling": "inference",
      "must_not_retrieve": [
        "calendar_events.title",
        "conversation_messages.content",
        "content"
      ],
      "implementation_status": "live",
      "required_health": {
        "time.depth_score": 0.3
      },
      "default_source_ids": [
        "demo_calendar_file",
        "calendar_stub"
      ],
      "fit_facets_exposed": [
        "timing_feasibility",
        "commitment_conflict"
      ]
    },
    {
      "scope_id": "complexity:read",
      "description": "Structure readings: focus concentration vs personal baseline, structural clarity of the entity graph, information breadth, pipeline confidence, weekly shift spikes, and ranked influence threads between entities and topics.",
      "example_questions": [
        "How focused have I been this month?",
        "Is my attention more scattered than usual?",
        "What is influencing my work on this project?",
        "How has the structure of my activity shifted recently?"
      ],
      "primary_dimensions": [
        "Interests"
      ],
      "raw_tables": [],
      "signal_objects": [
        "complexity_summary",
        "complexity_influence"
      ],
      "summary_objects": [
        "complexity_summary",
        "complexity_influence"
      ],
      "inference_objects": [],
      "default_mode_ceiling": "summary",
      "default_source_ids": [],
      "implementation_status": "live"
    },
    {
      "scope_id": "contacts:resolve",
      "description": "Contact and identifier resolution used to link names, numbers, and handles to people. Enrichment-only scope.",
      "example_questions": [
        "Which contact does this phone number belong to?"
      ],
      "primary_dimensions": [
        "Relationships"
      ],
      "raw_tables": [
        "contacts",
        "contact_identifiers"
      ],
      "signal_objects": [],
      "summary_objects": [],
      "inference_objects": [],
      "default_mode_ceiling": "raw",
      "enrichment_only": true,
      "implementation_status": "live",
      "default_source_ids": [
        "canonical_address_book"
      ]
    },
    {
      "scope_id": "health:read",
