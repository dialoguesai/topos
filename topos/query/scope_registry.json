      ],
      "default_mode_ceiling": "summary",
      "implementation_status": "live",
      "default_source_ids": [
        "demo_journal_file"
      ]
    },
    {
      "scope_id": "messages:read",
      "description": "Person-to-person messages (iMessage, Signal, messenger imports): message text, excerpts, entities, emotion signals, and authored goals extracted from owner-sent messages.",
      "example_questions": [
        "Find the messages where we planned the trip.",
        "Who do I message most?",
        "What goals have I mentioned in my messages?"
      ],
      "primary_dimensions": [
        "Relationships",
        "Memory"
      ],
      "raw_tables": [
        "conversation_messages"
      ],
      "signal_objects": [
        "message_entities",
        "message_emotions",
        "user_goals"
      ],
      "summary_objects": [
        "message_excerpts_summary"
      ],
      "inference_objects": [
        "message_inference"
      ],
      "default_mode_ceiling": "summary",
      "implementation_status": "live",
      "default_source_ids": [
        "demo_messenger_file",
        "imessage",
        "signal"
      ]
    },
