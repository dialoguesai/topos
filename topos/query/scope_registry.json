{
  "$schema": "topos/scope-registry-mvp-v1",
  "version": "1.0.0",
  "description": "Wiki-aligned MVP scope catalog. Source of truth for PRD; migrate to control_plane/uma/scope_registry.json in Phase 0.",
  "scopes": [
    {
      "scope_id": "activity:read",
      "primary_dimensions": ["Profile", "Interests"],
      "raw_tables": ["activity_events"],
      "signal_objects": ["activity_tags", "top_topics"],
      "summary_objects": ["activity_summary"],
      "inference_objects": ["interest_scores"],
      "default_mode_ceiling": "summary"
    },
    {
      "scope_id": "health:read",
      "primary_dimensions": ["Wellbeing"],
      "raw_tables": ["journal_entries"],
      "signal_objects": [],
      "summary_objects": ["wellness_summary"],
      "inference_objects": ["wellness_scores"],
      "default_mode_ceiling": "summary"
    },
    {
      "scope_id": "relationship_context:read",
      "primary_dimensions": ["Relationships"],
      "raw_tables": [],
      "signal_objects": ["relationship_edges", "relationship_scores"],
      "summary_objects": ["relationship_dimension_summary"],
      "inference_objects": ["relationship_inference"],
      "default_mode_ceiling": "inference"
    },
    {
      "scope_id": "messages:read",
      "primary_dimensions": ["Relationships", "Memory"],
      "raw_tables": ["conversation_messages"],
      "signal_objects": ["message_entities", "message_emotions"],
      "summary_objects": ["message_excerpts_summary"],
      "inference_objects": [],
      "default_mode_ceiling": "raw"
    },
    {
      "scope_id": "ai_conversations:read",
      "primary_dimensions": ["Memory", "Work"],
      "raw_tables": ["ai_chat_messages"],
      "signal_objects": ["message_topics", "user_goals"],
      "summary_objects": ["memory_dimension_summary"],
      "inference_objects": ["goal_inference"],
      "default_mode_ceiling": "summary"
    },
    {
      "scope_id": "schedule:read",
      "primary_dimensions": ["Time"],
      "raw_tables": ["calendar_events"],
      "signal_objects": ["event_counts"],
      "summary_objects": ["schedule_summary"],
      "inference_objects": [],
      "default_mode_ceiling": "raw"
    },
    {
      "scope_id": "availability:read",
      "primary_dimensions": ["Time"],
      "raw_tables": [],
      "signal_objects": ["availability_scores", "busy_blocks"],
      "summary_objects": ["availability_summary"],
      "inference_objects": ["availability_windows"],
      "default_mode_ceiling": "inference",
      "must_not_retrieve": ["calendar_events.title", "conversation_messages.content", "content"]
    },
    {
      "scope_id": "work_context:read",
      "primary_dimensions": ["Work"],
      "raw_tables": [],
      "signal_objects": ["user_goals"],
      "summary_objects": ["work_stub_summary"],
      "inference_objects": [],
      "default_mode_ceiling": "summary"
    },
    {
      "scope_id": "public_bio:read",
      "primary_dimensions": ["Profile"],
      "raw_tables": [],
      "signal_objects": [],
      "summary_objects": ["public_bio"],
      "inference_objects": [],
      "default_mode_ceiling": "summary"
    },
    {
      "scope_id": "contacts:resolve",
      "primary_dimensions": ["Relationships"],
      "raw_tables": ["contacts", "contact_identifiers"],
      "signal_objects": [],
      "summary_objects": [],
      "inference_objects": [],
      "default_mode_ceiling": "raw",
      "enrichment_only": true
    }
  ],
  "migration_from_legacy": {
    "aiMessages:read": "ai_conversations:read",
    "aiChat:read": "ai_conversations:read",
    "events:read": "schedule:read",
    "events:write": "schedule:read",
    "activitySummary:read": "activity:read",
    "wellnessSummary:read": "health:read",
    "publicBio:read": "public_bio:read",
    "messages:read": "messages:read",
    "activity:read": "activity:read",
    "journal:read": "health:read",
    "contacts:resolve": "contacts:resolve"
  }
}
