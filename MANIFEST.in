# Package data that must ship in the sdist/wheel (with include-package-data = true).
# Without these the installed node is missing its runtime config — most visibly
# topos/query/scope_registry.json, whose absence denies every scoped query.
recursive-include topos *.json
recursive-include shared *.json
# Tray icon glyphs (topos/cli/assets) — without them the tray cannot render.
recursive-include topos *.png
recursive-include topos/features/derivation/bundled_packs *.yaml
